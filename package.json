{
  "name": "ai-pricing-hub-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "MCP server: LLM pricing comparison, cost estimation, model recommendation and cloud compute benchmarking. By OptimNow.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/server/src/index.js",
    "deploy": "fly deploy",
    "refresh-fallback": "node scripts/refresh-llm-fallback.mjs",
    "check-parity": "node scripts/check-site-parity.mjs",
    "test": "node --import tsx --test \"server/src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
