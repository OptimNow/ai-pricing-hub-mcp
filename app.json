{
  "$schema": "https://chatgpt.com/schemas/app/v1.json",
  "id": "ai-pricing-hub",
  "name": "OptimToken",
  "version": "0.1.0",
  "description": "Compare LLM pricing, estimate workload costs, and benchmark cloud compute prices.",
  "mcp": {
    "server_url": "https://ai-pricing-hub-mcp-9604f763.alpic.live/"
  },
  "tools": [
    {
      "name": "compare-llm-models",
      "title": "Compare LLM Models",
      "description": "Compare AI/LLM models by price, quality (ELO), efficiency, and capabilities.",
      "input_schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "openness": {
            "type": "string",
            "enum": ["Open source", "Open weights", "Proprietary", "Unknown"]
          },
          "capability": {
            "type": "string"
          },
          "maxInputPrice": {
            "type": "number"
          },
          "maxOutputPrice": {
            "type": "number"
          },
          "minElo": {
            "type": "number"
          },
          "useCasePreset": {
            "type": "string",
            "enum": [
              "supportTicket",
              "knowledgeQA",
              "meetingSummary",
              "marketingContent",
              "codingTask",
              "invoiceProcessing",
              "callSummary",
              "agentWorkflow"
            ]
          },
          "volumePreset": {
            "type": "string",
            "enum": [
              "10k",
              "100k",
              "1m"
            ]
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "ui_resource": "ui://widget/compare-llm-models"
    },
    {
      "name": "estimate-llm-cost",
      "title": "Estimate LLM Cost",
      "description": "Estimate per-request and monthly costs for AI models.",
      "input_schema": {
        "type": "object",
        "properties": {
          "modelName": {
            "type": "string"
          },
          "useCasePreset": {
            "type": "string",
            "enum": [
              "supportTicket",
              "knowledgeQA",
              "meetingSummary",
              "marketingContent",
              "codingTask",
              "invoiceProcessing",
              "callSummary",
              "agentWorkflow"
            ]
          },
          "customInputTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "customOutputTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "monthlyVolume": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "additionalProperties": false
      },
      "ui_resource": "ui://widget/estimate-llm-cost"
    },
    {
      "name": "compare-compute-pricing",
      "title": "Compare Cloud Compute Pricing",
      "description": "Compare compute instance pricing across major cloud providers.",
      "input_schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "minVCPUs": {
            "type": "number"
          },
          "maxVCPUs": {
            "type": "number"
          },
          "minMemory": {
            "type": "number"
          },
          "maxMemory": {
            "type": "number"
          },
          "processor": {
            "type": "string"
          },
          "useCase": {
            "type": "string"
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "price",
              "vcpus",
              "memory",
              "pricePerVCPU"
            ]
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "ui_resource": "ui://widget/compare-compute-pricing"
    }
  ],
  "ui_resources": [
    {
      "uri": "ui://widget/compare-llm-models",
      "source": "web/src/widgets/compare-llm-models/index.tsx"
    },
    {
      "uri": "ui://widget/estimate-llm-cost",
      "source": "web/src/widgets/estimate-llm-cost/index.tsx"
    },
    {
      "uri": "ui://widget/compare-compute-pricing",
      "source": "web/src/widgets/compare-compute-pricing/index.tsx"
    }
  ]
}
